@article{Smith1998Bridge,
  abstract = {Bridge baron won the 1997 Baron Barclay World Bridge Computer Challenge by replacing brute force game tree search with Hierarchical Task Network (HTN) planning. It plans declarer play the way a human would, building small game trees from named schemes like finessing and ruffing instead of brute forcing every move. The paper covers the planning techniques used and discusses what the tournament win means for AI planning research.},
  author = {Smith, Stephen J and Nau, Dana and Throop, Tom},
  doi = {10.1609/aimag.v19i2.1371},
  journal = {AI Magazine},
  keywords = {method:planning, game:trick-taking, type:methods},
  number = {2},
  publisher = {AAAI},
  volume = {19},
  series = {AI Magazine},
  pages = {93--105},
  title = {Computer Bridge: A Big Win for AI Planning},
  url = {https://teaching.csse.uwa.edu.au/units/CITS3001/project/2017/paper2.pdf},
  year = {1998}
}

@article{Cowling2012Information,
  abstract = {This paper presents Information Set Monte Carlo Tree Search (ISMCTS), three search methods for games with hidden information. Instead of building separate trees for each guess of the hidden state, ISMCTS builds one tree where nodes are information sets, putting all the search effort in one place. The three variants handle fully observable moves, partially observable moves, and one tree per player. Tested on Lord of the Rings: The Confrontation, the Phantom (4,4,4) game, and Dou Di Zhu against humans and a commercial AI.},
  author = {Cowling, Peter I and Powley, Edward J and Whitehouse, Daniel},
  doi = {10.1109/TCIAIG.2012.2200894},
  journal = {IEEE Transactions on Computational Intelligence and AI in Games},
  keywords = {method:search, game:trick-taking, type:methods},
  number = {2},
  publisher = {IEEE},
  volume = {4},
  series = {TCIAIG},
  pages = {120--143},
  title = {Information Set Monte Carlo Tree Search},
  url = {https://doi.org/10.1109/TCIAIG.2012.2200894},
  year = {2012}
}

@article{Schofield2019General,
  abstract = {This paper introduces HyperPlay and HyperPlay II, two methods that let general game playing programs handle games with hidden information described in GDL II. HyperPlay keeps a handful of guesses about the hidden state and updates them with random move fills, leaning on Ockham's Razor to favour simpler explanations. HyperPlay II nests one HyperPlayer per role inside an Imperfect Information Simulation that replays the game from the start, fixing the strategy fusion problem and properly handling information gathering plays.},
  author = {Schofield, Michael and Thielscher, Michael},
  doi = {10.1613/jair.1.11844},
  journal = {Journal of Artificial Intelligence Research},
  keywords = {method:search, game:other, type:methods},
  publisher = {AI Access Foundation},
  volume = {66},
  series = {JAIR},
  pages = {901--935},
  title = {General Game Playing with Imperfect Information},
  url = {https://doi.org/10.1613/jair.1.11844},
  year = {2019}
}

@article{Swiechowski2023Monte,
  abstract = {This paper surveys recent work on Monte Carlo Tree Search (MCTS), an algorithm that picks moves by simulating random plays and using the results to decide what to do next. It updates the earlier Browne et al. survey by collecting papers from IEEE Xplore, dblp and Google Scholar, then sorts them into seven groups covering classic MCTS, perfect information games, imperfect information games, hybrids with machine learning and evolutionary methods, applications outside games, and parallelisation. Two summary tables group the references by method and by application.},
  author = {Świechowski, Maciej and Godlewski, Konrad and Sawicki, Bartosz and Mańdziuk, Jacek},
  doi = {10.1007/s10462-022-10228-y},
  journal = {Artificial Intelligence Review},
  keywords = {method:search, game:other, type:survey},
  number = {3},
  publisher = {Springer},
  volume = {56},
  series = {AIR},
  pages = {2497--2562},
  title = {Monte Carlo Tree Search: a review of recent modifications and applications},
  url = {https://doi.org/10.1007/s10462-022-10228-y},
  year = {2023}
}

@article{Mnih2015Human,
  abstract = {This paper introduces the deep Q network (DQN), an agent that learns to play games directly from pixels using reinforcement learning. It combines Q learning with a deep convolutional neural network and stabilises training with two tricks: experience replay, which samples old transitions at random, and a target network whose weights only update every few steps. DQN is tested across 49 Atari 2600 games using the same setup throughout, beating a professional human tester on most titles.},
  author = {Mnih, Volodymyr and Kavukcuoglu, Koray and Silver, David and Rusu, Andrei A and Veness, Joel and Bellemare, Marc G and Graves, Alex and Riedmiller, Martin and Fidjeland, Andreas K and Ostrovski, Georg and Petersen, Stig and Beattie, Charles and Sadik, Amir and Antonoglou, Ioannis and King, Helen and Kumaran, Dharshan and Wierstra, Daan and Legg, Shane and Hassabis, Demis},
  doi = {10.1038/nature14236},
  journal = {Nature},
  keywords = {method:learning, game:perfect-info, type:methods},
  number = {7540},
  publisher = {Nature},
  volume = {518},
  series = {Nature},
  pages = {529--533},
  title = {Human level control through deep reinforcement learning},
  url = {https://doi.org/10.1038/nature14236},
  year = {2015}
}

@article{Silver2017Mastering,
  abstract = {This paper introduces AlphaGo Zero, the first program to master Go at near perfect level using only self play and the board position as input, with no human game data. It replaces AlphaGo's separate policy and value networks with a single residual convolutional network that outputs both. Each training loop runs an MCTS guided by the network, then trains the network to match the stronger move probabilities the search produced. AlphaGo Zero beat AlphaGo Lee 100 to 0 and AlphaGo Master 89 to 11.},
  author = {Silver, David and Schrittwieser, Julian and Simonyan, Karen and Antonoglou, Ioannis and Huang, Aja and Guez, Arthur and Hubert, Thomas and Baker, Lucas and Lai, Matthew and Bolton, Adrian and Chen, Yutian and Lillicrap, Timothy and Hui, Fan and Sifre, Laurent and van den Driessche, George and Graepel, Thore and Hassabis, Demis},
  doi = {10.1038/nature24270},
  journal = {Nature},
  keywords = {method:hybrid, game:perfect-info, type:methods},
  number = {7676},
  publisher = {Nature},
  volume = {550},
  series = {Nature},
  pages = {354--359},
  title = {Mastering the game of Go without human knowledge},
  url = {https://doi.org/10.1038/nature24270},
  year = {2017}
}

@inproceedings{Baykal2019Reinforcement,
  abstract = {This paper builds self learning agents that play Batak, a Turkish trick taking card game using a standard 52 card deck. Three agents are trained: two gameplay agents using Monte Carlo reinforcement learning, one trying to win tricks and one trying to lose them, plus a bidding agent that learns from simulated games. Because Batak has too many states for a lookup table, neural networks approximate the value function from 52 one hot vectors encoding where every card sits. Evaluation runs 1,000 test games against three rule based opponents every 10,000 training games, across 200,000 games of training in total.},
  author = {Baykal, Ömer and Alpaslan, Ferda Nur},
  doi = {10.1109/UBMK.2019.8907235},
  booktitle = {2019 4th International Conference on Computer Science and Engineering (UBMK)},
  keywords = {method:learning, game:trick-taking, type:application},
  publisher = {IEEE},
  series = {UBMK},
  pages = {618--623},
  title = {Reinforcement Learning in Card Game Environments Using Monte Carlo Methods and Artificial Neural Networks},
  url = {https://doi.org/10.1109/UBMK.2019.8907235},
  year = {2019}
}

@inproceedings{Brown2020Combining,
  abstract = {This paper introduces ReBeL (Recursive Belief based Learning), the first method that makes AlphaZero style self play and search work on games with hidden information like poker. It tracks the game state as a public belief state, a set of odds over what each player might hold. Two networks, one for value and one for policy, are trained through self play, while a short counterfactual regret search runs at each step. ReBeL beats top poker bots and pro player Dong Kim at no limit Texas hold'em and Liar's Dice.},
  author = {Brown, Noam and Bakhtin, Anton and Lerer, Adam and Gong, Qucheng},
  doi = {10.48550/arXiv.2007.13544},
  booktitle = {Advances in Neural Information Processing Systems 33 (NeurIPS 2020)},
  keywords = {method:hybrid, game:poker-style, type:methods},
  publisher = {Curran Associates},
  volume = {33},
  series = {NeurIPS},
  pages = {17057--17069},
  title = {Combining Deep Reinforcement Learning and Search for Imperfect Information Games},
  url = {https://proceedings.neurips.cc/paper/2020/hash/c61f571dbd2fb949d3fe5ae1608dd48b-Abstract.html},
  year = {2020}
}

@article{Chrustowski2025Policy,
  abstract = {This paper trains an agent to play the trick taking stage of two player Thousand Schnapsen, a Polish card game with too many possible states for MCTS or deep counterfactual regret to handle. The authors tweak REINFORCE in three ways: teaching it the legal moves first, replaying past experience with weighted samples, and a setting that focuses learning on important deals. The agent wins 65% of games against a random opponent and 55% against deep alpha beta search over 10,000 deals.},
  author = {Chrustowski, Kamil and Duch, Piotr},
  doi = {10.3390/app15042121},
  journal = {Applied Sciences},
  keywords = {method:learning, game:trick-taking, type:methods},
  number = {4},
  publisher = {MDPI},
  volume = {15},
  series = {Applied Sciences},
  pages = {2121},
  title = {Policy Based Reinforcement Learning Approach in Imperfect Information Card Game},
  url = {https://doi.org/10.3390/app15042121},
  year = {2025}
}

@article{Luo2026Artificial,
  abstract = {This paper surveys AI methods for imperfect information card games using DouDiZhu, a three player Chinese card game with hidden cards, cooperation, competition and sparse rewards, as the benchmark. It is the first survey to treat DouDiZhu as the go to benchmark for the field. Existing methods are sorted into five groups: MCTS, DQN, Deep Monte Carlo, PPO, and hybrids. Agents like DeltaDou, DouZero, PerfectDou and AlphaDou are ranked by win percentage, average difference in points and Elo rating.},
  author = {Luo, Qian and Zha, Daochen and Zhang, Tianqiao and Tan, Xuewen},
  doi = {10.36227/techrxiv.177281409.97588134/v1},
  journal = {TechRxiv},
  keywords = {method:hybrid, game:climbing, type:survey},
  publisher = {TechRxiv},
  series = {TechRxiv preprint},
  title = {Artificial Intelligence for Imperfect Information Card Games: A Survey Using DouDiZhu as Benchmark},
  url = {https://doi.org/10.36227/techrxiv.177281409.97588134/v1},
  year = {2026}
}